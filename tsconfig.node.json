{
  /* The root tsconfig.json only includes src/ plus api/**\/*.d.ts, so every
     serverless function under api/ and every script under evals/ was going
     unchecked — `npm run build` bundles the client and never looks at them.
     This config covers that surface. Run it with `npm run typecheck:node`.

     Separate from the root config because these run on Node (NodeNext module
     resolution, `.js` import specifiers resolving to `.ts` sources, @types/node)
     rather than in the browser through Vite's bundler resolution. */
  "include": ["api/**/*.ts", "evals/**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
